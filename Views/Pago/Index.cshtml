@model IEnumerable<Pago>
@{
    ViewData["Title"] = "Pagos";
}

<link rel="stylesheet" href="~/css/tablas.css">

<h1 class="text-center display-4">Pagos</h1>

<div class="container-fluid shadow border rounded-4 mt-4 bg-light-subtle position-relative">
    <div class="table-responsive my-4 rounded-3 fixed-height-table-container">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th style="width: 100px;">
                        @Html.DisplayNameFor(model => model.Id)
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Fecha).ToUpper()
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Importe).ToUpper()
                    </th>
                    <th colspan="2">
                        @Html.DisplayNameFor(model => model.Concepto).ToUpper()
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Anulado).ToUpper()
                    </th>
                    @* <th colspan="2">
                        @Html.DisplayNameFor(model => model.Detalle).ToUpper()
                    </th> *@
                    <th></th>
                </tr>
            </thead>
            <tbody id="cuerpo">
                @foreach (var item in Model)
                {
                    <tr id="@item.Id">
                        <td class="align-middle py-0 ps-2" style="width: 100px;">
                            @Html.DisplayFor(modelItem => item.Id)
                        </td>
                        <td class="align-middle py-0 ps-2">
                            @Html.DisplayFor(modelItem => item.Fecha)
                        </td>
                        <td class="align-middle py-0 ps-2">
                            @Html.DisplayFor(modelItem => item.Importe)
                        </td>
                        <td class="align-middle py-0 ps-2" colspan="2">
                            @Html.DisplayFor(modelItem => item.Concepto)
                        </td>
                        <td class="align-middle py-0 ps-2">
                            @(item.Anulado ? " ANULADO " : " - ")
                        </td>
                        @* <td class="align-middle py-0 ps-2" colspan="2">
                            @Html.DisplayFor(modelItem => item.Detalle)
                        </td> *@
                        <td>
                            <div class="d-flex justify-content-evenly align-items-center">
                                @* <i id="edit-@item.Id" class="bi bi-pencil-square fs-3 text-primary icon-hover" style="cursor: pointer;" data-bs-toggle="tooltip" data-bs-title="Editar"></i> *@
                                <a class="icon-enlace" asp-controller="Pago" asp-action="Formulario" asp-route-id="@item.Id" data-bs-toggle="tooltip" data-bs-title="Editar">
                                    <i class="bi bi-pencil-square fs-3 text-primary icon-hover"></i>
                                </a>
                                <i id="del-@item.Id" class="bi bi-trash fs-3 text-danger icon-hover @(!item.Anulado ? "invisible" : "")" style="cursor: pointer;" data-bs-toggle="tooltip" data-bs-title="Anular"></i>
                                <i id="det-@item.Id" class="bi bi-file-earmark-text fs-3 text-info icon-hover" style="cursor: pointer;" data-bs-toggle="tooltip" data-bs-title="Ver Detalle"></i>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <nav>
        <ul id="paginador" class="pagination justify-content-center">
            <li id="flecha-pag-izq" class="page-item @(ViewBag.paginaAnterior == 0 ? "disabled" : "")">
                @if(ViewBag.reservaId != null) {
                    <a asp-action="Index" asp-route-reservaId="@ViewBag.reservaId" asp-route-cantidadPaginado="@ViewBag.cantidadPaginado" asp-route-pagina="@ViewBag.paginaAnterior" class="page-link"><span>&laquo;</span></a>
                } else {
                    <a asp-action="Index" asp-route-cantidadPaginado="@ViewBag.cantidadPaginado" asp-route-pagina="@ViewBag.paginaAnterior" class="page-link"><span>&laquo;</span></a>
                }
            </li>
            @for (int i = 1; i <= ViewBag.cantPag; i++) {
                <li class="page-item">
                    @if(ViewBag.reservaId != null) {
                        <a asp-action="Index" asp-route-reservaId="@ViewBag.reservaId" asp-route-cantidadPaginado="@ViewBag.cantidadPaginado" asp-route-pagina="@i" class="page-link @(i > ViewBag.paginaAnterior && i < ViewBag.paginaSiguiente ? "active" : "")">@i</a>
                    } else {
                        <a asp-action="Index" asp-route-cantidadPaginado="@ViewBag.cantidadPaginado" asp-route-pagina="@i" class="page-link @(i > ViewBag.paginaAnterior && i < ViewBag.paginaSiguiente ? "active" : "")">@i</a>
                    }
                </li>
            }
            <li id="flecha-pag-der" class="page-item @(ViewBag.paginaSiguiente > ViewBag.cantPag ? "disabled" : "")">
                @if(ViewBag.reservaId != null) {
                    <a asp-action="Index" asp-route-reservaId="@ViewBag.reservaId" asp-route-cantidadPaginado="@ViewBag.cantidadPaginado" asp-route-pagina="@ViewBag.paginaSiguiente" class="page-link"><span>&raquo;</span></a>
                } else {
                    <a asp-action="Index" asp-route-cantidadPaginado="@ViewBag.cantidadPaginado" asp-route-pagina="@ViewBag.paginaSiguiente" class="page-link"><span>&raquo;</span></a>
                }
            </li>
        </ul>
    </nav>
    @if(ViewBag.reservaId != 0) {
        <div class="position-absolute bottom-0 start-0 ms-4 mb-2 contenedor-iconos">
            <a asp-controller="Contrato" asp-action="Index" class="icon-enlace d-inline-block">
                <i class="bi bi-box-arrow-in-left fs-1 text-primary" data-bs-toggle="tooltip" data-bs-title="Volver a Reservas"></i>
            </a>
        </div>
        <div id="btn_add" class="position-absolute bottom-0 end-0 me-4 mb-2" style="cursor: pointer;">
            <a class="icon-enlace d-inline-block" asp-action="Formulario" asp-controller="Pago" asp-route-reservaId="@ViewBag.reservaId" data-bs-toggle="tooltip" data-bs-title="Registrar Pago">
                <i class="bi bi-plus-square fs-1 text-primary"></i>
            </a>
        </div>
    }
</div>

<partial name="_DetailsPagoModal"/>
<partial name="_ModalEliminar"/>

@if(!string.IsNullOrEmpty(ViewBag.MensajeError)) {
    <partial name="_MensajeError" model="ViewBag.MensajeError"/>
}

@section Scripts{
    <script type="module">
        import { getElementById, mostrarMensaje, mostrarPregunta } from "/js/frontUtils.js";

        document.addEventListener("DOMContentLoaded", () => {
            mostrarMensaje(false, null);

            document.querySelectorAll(".bi-trash")?.forEach(i => {
                i.addEventListener("click", e => {
                const idFila = e.target.id.split("-")[1];
                getElementById("form_eliminar").action = `/Pago/Eliminar/${idFila}`;
                mostrarPregunta(null);
                });
            });

            document.querySelectorAll("td .bi-file-earmark-text")?.forEach(i => {
                i.addEventListener("click", async e => {
                const idFila = e.target.id.split("-")[1];
                const respuesta = await fetch(`/Pago/Buscar/${idFila}`);
                const datos = await respuesta.json();
                mostrarModalDetalle(datos.pago);
                });
            });
        });

        function mostrarModalDetalle(pago) {
            getElementById("nro").textContent = pago.id;
            getElementById("fPago_detalle").textContent = aFechaLocal(pago.fecha?.split("T")[0]);
            getElementById("importePago_detalle").textContent = `$ ${pago.importe}`;
            getElementById("concepto_detalle").textContent = pago.concepto;
            getElementById("estadoPago_detalle").textContent = pago.anulado ? "ANULADO ❌" : "VÁLIDO ✔";
            getElementById("propietario_detalle").textContent = `${pago.reserva.inmueble.duenio.apellido}, ${pago.reserva.inmueble.duenio.nombre}`;
            getElementById("inquilino_detalle").textContent = `${pago.reserva.inquilino.apellido}, ${pago.reserva.inquilino.nombre}`;
            getElementById("tipo_inmueble_detalle").textContent = pago.reserva.inmueble.tipo.tipo;
            getElementById("cupo_detalle").textContent = pago.reserva.inmueble.cupo;
            getElementById("precio_detalle").textContent = `$ ${pago.reserva.inmueble.precio}`;
            getElementById("senia_detalle").textContent = `${pago.reserva.inmueble.senia} %`;
            getElementById("dir_detalle").textContent = `${pago.reserva.inmueble.calle} ${pago.reserva.inmueble.nroCalle}`;
            getElementById("lat_detalle").textContent = pago.reserva.inmueble.latitud;
            getElementById("long_detalle").textContent = pago.reserva.inmueble.longitud;
            getElementById("habilitado_detalle").textContent = pago.reserva.inmueble.disponible ? "✔" : "❌";
            getElementById("fIni_detalle").textContent = aFechaLocal(pago.reserva.fechaInicio?.split("T")[0]);
            getElementById("fFin_detalle").textContent = aFechaLocal(pago.reserva.fechaFin?.split("T")[0]);
            getElementById("monto_detalle").textContent = `$ ${pago.reserva.monto}`;
            getElementById("fTerm_detalle").textContent = pago.reserva.fechaTerminado ? aFechaLocal(pago.reserva.fechaTerminado?.split("T")[0]) : " - ";

            const myModal = new bootstrap.Modal(getElementById('modal_detalle_pago'), {});
            myModal.show();
        }

        function aFechaLocal(fecha) {
            if (!fecha) return;
            return fecha.split("-").reverse().join("/");
        }
    </script>
}