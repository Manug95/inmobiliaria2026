<div id="modal_detalle_pago" class="modal fade modal-xl" tabindex="-1" aria-describedby="titulo-modal">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <div id="titulo-modal" class="modal-title fs-4 text-primary-emphasis">Detalle del Pago N° <span id="nro"></span></div>
                <button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body justify-content-center align-items-center">
                <div class="container-fluid align-middle">
                    <div class="row">
                        <div class="col">
                            <span class="fw-bold fs-3 text-info-emphasis">Fecha de Pago: &nbsp;</span>
                            <span id="fPago_detalle" class="fs-4"></span>
                        </div>
                        <div class="col">
                            <span class="fw-bold fs-3 text-info-emphasis">Importe Pago: &nbsp;</span>
                            <span id="importePago_detalle" class="fs-4"></span>
                        </div>
                        <div class="col">
                            <span class="fw-bold fs-3 text-info-emphasis">Estado: &nbsp;</span>
                            <span id="estadoPago_detalle" class="fs-4"></span>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col">
                            <span class="fw-bold fs-3 text-info-emphasis">Concepto Pago: &nbsp;</span>
                            <span id="concepto_detalle" class="fs-4"></span>
                        </div>
                    </div>
                    @if (User.IsInRole(Rol.ADMIN.ToString())) {
                        <div class="row">
                            <div class="col">
                                <span class="fw-bold fs-3 text-info-emphasis">Usuario Cobrador: &nbsp;</span>
                                <span id="cobrador_detalle" class="fs-4"></span>
                            </div>
                            <div class="col">
                                <span class="fw-bold fs-3 text-info-emphasis">Usuario Anulador: &nbsp;</span>
                                <span id="anulador_detalle" class="fs-4"></span>
                            </div>
                        </div>
                    }

                    <br>
                    <h5 class="display-6 text-primary-emphasis">Reserva</h5>
                    <hr>

                    <div class="row">
                        <div class="col">
                            <span class="fw-bold fs-3 text-info-emphasis">Fecha de Inicio: &nbsp;</span>
                            <span id="fIni_detalle" class="fs-4"></span>
                        </div>
                        <div class="col">
                            <span class="fw-bold fs-3 text-info-emphasis">Fecha de Finalización: &nbsp;</span>
                            <span id="fFin_detalle" class="fs-4"></span>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col">
                            <span class="fw-bold fs-3 text-info-emphasis">Monto: &nbsp;</span>
                            <span id="monto_detalle" class="fs-4"></span>
                        </div>
                        <div class="col">
                            <span class="fw-bold fs-3 text-info-emphasis">Fecha Terminado: &nbsp;</span>
                            <span id="fTerm_detalle" class="fs-4"></span>
                        </div>
                    </div>

                    <br>
                    <h5 class="display-6 text-primary-emphasis">Inquilino</h5>
                    <hr>

                    <div class="row">
                        <div class="col">
                            <span class="fw-bold fs-3 text-info-emphasis">Inquilino: &nbsp;</span>
                            <span id="inquilino_detalle" class="fs-4"></span>
                        </div>
                    </div>

                    <br>
                    <h5 class="display-6 text-primary-emphasis">Inmueble</h5>
                    <hr>

                    <div class="row">
                        <div class="col">
                            <span class="fw-bold fs-3 text-info-emphasis">Propietario: &nbsp;</span>
                            <span id="propietario_detalle" class="fs-4"></span>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col">
                            <span class="fw-bold fs-3 text-info-emphasis">Tipo de Inmueble: &nbsp;</span>
                            <span id="tipo_inmueble_detalle" class="fs-4"></span>
                        </div>
                        <div class="col">
                            <span class="fw-bold fs-3 text-info-emphasis">Cupo: &nbsp;</span>
                            <span id="cupo_detalle" class="fs-4"></span>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col">
                            <span class="fw-bold fs-3 text-info-emphasis">Precio: &nbsp;</span>
                            <span id="precio_detalle" class="fs-4"></span>
                        </div>
                        <div class="col">
                            <span class="fw-bold fs-3 text-info-emphasis">Seña: &nbsp;</span>
                            <span id="senia_detalle" class="fs-4"></span>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col">
                            <span class="fw-bold fs-3 text-info-emphasis">Dirección: &nbsp;</span>
                            <span id="dir_detalle" class="fs-4"></span>
                        </div>
                        <div class="col">
                            <span class="fw-bold fs-3 text-info-emphasis">Habilitado: &nbsp;</span>
                            <span id="habilitado_detalle" class="fs-4"></span>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col">
                            <span class="fw-bold fs-3 text-info-emphasis">Latitud: &nbsp;</span>
                            <span id="lat_detalle" class="fs-4"></span>
                        </div>
                        <div class="col">
                            <span class="fw-bold fs-3 text-info-emphasis">Longitud: &nbsp;</span>
                            <span id="long_detalle" class="fs-4"></span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>