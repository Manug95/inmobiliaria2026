    <div class="row mt-2 mb-3">
        <div class="row bg-light w-75 mx-auto border rounded-4 shadow-sm px-0">
            <div class="col-12 @(!string.IsNullOrWhiteSpace(Model.UsuarioViewModel!.Avatar)?"col-md-8":"") mt-5 mt-md-1 mb-md-0 px-1">
                <form asp-action="ActualizarAvatar" enctype="multipart/form-data" id="form-avatar-usuario" class="mt-2 mb-3 bg-light-subtle">
                    <legend class="ps-3">Cambiar el Avatar</legend>
                    <div class="border rounded-4 shadow-sm p-3">
                        <label asp-for="UsuarioViewModel.AvatarFile" class="form-label fw-bold">Avatar</label>
                        <input type="file" asp-for="UsuarioViewModel.AvatarFile" class="form-control" id="Avatar" accept="image/*">
                        <span asp-validation-for="UsuarioViewModel.AvatarFile" class="text-danger small"></span>
                    </div>
                    <input type="hidden" asp-for="UsuarioViewModel.Id"/>
                    @* <div class="row mb-2 mt-5 mt-md-4 justify-content-center"> *@
                        @* <div class="col-2 d-flex justify-content-center"> *@
                            <input type="submit" value="Guardar" class="btn btn-primary d-block mx-auto mt-3">
                        @* </div> *@
                    @* </div> *@
                </form>
            </div>
            @if(!string.IsNullOrWhiteSpace(Model.UsuarioViewModel!.Avatar)){
                <div class="col-12 col-md-4 mt-2 mb-3 bg-light-subtle d-flex justify-content-evenly align-items-center">
                    <img src="@Model.UsuarioViewModel.Avatar" alt="" width="48" class="rounded-circle" data-bs-toggle="tooltip" data-bs-title="Mi Avatar"/>
                    <form asp-action="EliminarAvatar" asp-route-id="@Model.UsuarioViewModel.Id" method="post" class="">
                        <button type="submit" class="btn btn-danger btn-sm">
                            <i class="bi bi-trash"></i> Eliminar
                        </button>
                    </form>
                    @* <a class="icon-enlace align-top ms-3" asp-action="EliminarAvatar" asp-route-id="@Model.UsuarioViewModel.Id" asp-route-avatar="@Model.UsuarioViewModel.Avatar">
                        <i class="bi bi-trash fs-2 text-danger icon-hover" style="cursor: pointer;" data-bs-toggle="tooltip" data-bs-title="Eliminar Avatar"></i>
                    </a> *@
                </div>
            }
        </div>
    </div>
</div>

@if(!string.IsNullOrWhiteSpace(ViewBag.MensajeError)) {
    <partial name="_MensajeError" model="ViewBag.MensajeError" />
}

@section Scripts{
    <partial name="_ValidationScriptsPartial" />

    <script type="module" defer>
        import { mostrarMensaje } from "/js/frontUtils.js";
        document.addEventListener("DOMContentLoaded", _ => {
            mostrarMensaje(false, null);
        });
    </script>
}