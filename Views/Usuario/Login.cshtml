@using inmobiliaria2026.Models.ViewModels
@model LoginViewModel;

@{
    ViewData["Title"] = "Login";
}

<div class="container-md mt-3">
    <h1 class="text-center">Login</h1>

    <div class="d-flex justify-content-center align-items-center vh-50 w-50 mt-5 mx-auto">
        <form asp-action="Login" id="form-login2" class="p-3 w-75 mx-auto border rounded-4 shadow-sm needs-validation mt-3 mb-3 bg-light-subtle">
            <div class="row mb-md-4">
                <div class="col-12 mt-5 mt-md-3 mb-md-0">
                    <label asp-for="Email" class="form-label fw-bold">Email</label>
                    <input type="email" asp-for="Email" class="form-control" id="Email">
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>
                <div class="col-12 mt-5 mt-md-3 mb-md-0">
                    <label asp-for="Password" class="form-label fw-bold">Contraseña</label>
                    <input type="password" asp-for="Password" class="form-control" id="Password">
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>
                @if(!string.IsNullOrWhiteSpace(ViewBag.MensajeError)) {
                    <div class="text-danger">@ViewBag.MensajeError</div>
                }
            </div>
            <div class="row mb-2 mt-5 mt-md-4 justify-content-center">
                <div class="col-2 d-flex justify-content-center">
                    <input type="submit" value="Login" class="btn btn-primary d-block mx-auto">
                </div>
            </div>
        </form>

    </div>
</div>