@using System.Security.Claims
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - inmobiliaria2026</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/styles.css" asp-append-version="true" >
    <link rel="stylesheet" href="~/css/tablas.css" asp-append-version="true" >
    <link rel="stylesheet" href="~/inmobiliaria2026.styles.css" asp-append-version="true" />
</head>
<body>
    <header style="height: 5vh">
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light border-bottom box-shadow mb-1 p-0 fs-5" style="background-color: #e3f2fd;">
            <div class="container-fluid">
                <a class="navbar-brand nav-font" asp-area="" asp-controller="Home" asp-action="Index">Inmobiliaria</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item @(ViewBag?.linkActivo == "propietarios" ? "active-link" : "")">
                            <a class="nav-link text-dark nav-font" asp-area="" asp-controller="Propietario" asp-action="Index">Propietarios</a>
                        </li>
                        <li class="nav-item @(ViewBag?.linkActivo == "inquilinos" ? "active-link" : "")">
                            <a class="nav-link text-dark nav-font" asp-area="" asp-controller="Inquilino" asp-action="Index">Inquilinos</a>
                        </li>
                        <li class="nav-item dropdown @(ViewBag?.linkActivo == "inmuebles" ? "active-link" : "")">
                            <a class="nav-link dropdown-toggle text-dark nav-font" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                Inmuebles
                            </a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item text-dark nav-font" asp-area="" asp-controller="Inmueble" asp-action="Index">Lista Inmuebles</a></li>
                                <li><a class="dropdown-item text-dark nav-font" asp-area="" asp-controller="TipoInmueble" asp-action="Index">Tipos de Inmuebles</a></li>
                                <li><a class="dropdown-item text-dark nav-font" asp-area="" asp-controller="Inmueble" asp-action="Reservar">Reservar Inmueble</a></li>
                            </ul>
                        </li>
                        <li class="nav-item dropdown @(ViewBag?.linkActivo == "reservas" ? "active-link" : "")">
                            <a class="nav-link dropdown-toggle text-dark nav-font" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                Reservas
                            </a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item text-dark nav-font" asp-area="" asp-controller="Reserva" asp-action="Index">Lista Reservas</a></li>
                            </ul>
                        </li>
                        <li class="nav-item @(ViewBag?.linkActivo == "pagos" ? "active-link" : "")">
                            <a class="nav-link text-dark nav-font" asp-area="" asp-controller="Pago" asp-action="Index">Pagos</a>
                        </li>
                        <li class="nav-item dropdown @(ViewBag?.linkActivo == "informes" ? "active-link" : "")">
                            <a class="nav-link dropdown-toggle text-dark nav-font" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                Informes
                            </a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item text-dark nav-font" asp-area="" asp-controller="Reserva" asp-action="PorFechas">Reservas Vigentes por Fechas</a></li>
                                <li><a class="dropdown-item text-dark nav-font" asp-area="" asp-controller="Inmueble" asp-action="MasReservados">Inmuebles Más Reservados</a></li>
                            </ul>
                        </li>
                        @if (User.IsInRole(Rol.ADMIN.ToString())) {
                            <li class="nav-item @(ViewBag?.linkActivo == "usuarios" ? "active-link" : "")">
                                <a class="nav-link text-dark nav-font" asp-area="" asp-controller="Usuario" asp-action="Index">Usuarios</a>
                            </li>
                        }
                    </ul>
                    @if (User.Identity!.IsAuthenticated) {
                        <div class="dropdown">
                            <button class="btn btn-dark dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <span class="pe-3 ps-1">@User.Identity.Name</span>
                                @{string? avatarURL = User.Claims.FirstOrDefault(c => c.Type == ClaimTypes.Uri)?.Value;}
                                @if (avatarURL?.Length > 0) {
                                    <img width="32" src="@avatarURL" alt="" class="rounded-circle" asp-append-version="true" >
                                } else {
                                    string nombre = User!.Identity!.Name!.Split(" ")[0];
                                    string apellido = User.Identity.Name.Split(" ")[1];
                                    <img width="32" src="https://ui-avatars.com/api/?name=@(nombre + "+" + apellido)&background=random&rounded=true" alt="" asp-append-version="true" >
                                }
                            </button>
                            <ul class="dropdown-menu dropdown-menu-dark">
                                <li><span class="dropdown-item text-white">@User.Claims.FirstOrDefault(c => c.Type == ClaimTypes.Email)?.Value</span></li>
                                <li><hr class="dropdown-divider"></li>
                                @{string? id = User.Claims.FirstOrDefault(c => c.Type == "id")?.Value;}
                                <li><a class="dropdown-item text-white" asp-area="" asp-controller="Usuario" asp-action="Edit" asp-route-id="@id">Actualizar Perfil</a></li>
                                <li><a class="dropdown-item text-white" asp-area="" asp-controller="Usuario" asp-action="Logout">Salir</a></li>
                            </ul>
                        </div>
                    } else {
                        <a asp-controller="Usuario" asp-action="Login" type="button" class="btn btn-primary">Login</a>
                    }
                </div>
            </div>
        </nav>
    </header>
    <div class="container-fluid">
        <main role="main" class="pb-3 overflow-y-auto" style="height: 90vh">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted" style="height: 4vh">
        <div class="container">
            &copy; 2026 - inmobiliaria2026 - Gutierrez Manuel
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        const tooltipTriggerList = document.querySelectorAll('[data-bs-toggle="tooltip"]');
        const tooltipList = [...tooltipTriggerList].map(tooltipTriggerEl => new bootstrap.Tooltip(tooltipTriggerEl));
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
