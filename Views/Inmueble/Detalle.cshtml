@using inmobiliaria2026.Models.ViewModels
@model DetalleInmuebleViewModel

@{
    ViewData["Title"] = "Detalle Inmueble";
}

<div class="container border rounded-4 shadow-sm mt-2 p-3">
    @if(Model.Inmueble != null){
        <div class="row">
            <div class="col-5">
                <img src="@(Model.Inmueble.Foto ?? "/Uploads\\foto.jpg")" alt="Portada del inmueble" class="img-fluid rounded">
            </div>
            <div class="col-7">
                <div class="row mb-2">
                    <div class="col">
                        <span class="fw-bold">DIRECCION:</span>
                        &nbsp;
                        <span>@Model.Inmueble.Calle @Model.Inmueble.NroCalle</span>
                    </div>
                </div>
                <div class="row mb-2">
                    <div class="col">
                        <span class="fw-bold">@Html.DisplayNameFor(model => Model.Inmueble.Tipo).ToUpper():</span>
                        &nbsp;
                        <span>@(Model.Inmueble.Tipo?.Tipo ?? "Sin tipo de inmueble")</span>
                    </div>
                </div>
                <div class="row mb-2">
                    <div class="col">
                        <span class="fw-bold">@Html.DisplayNameFor(model => Model.Inmueble.Cupo).ToUpper():</span>
                        &nbsp;
                        <span>@Model.Inmueble.Cupo</span>
                    </div>
                </div>
                <div class="row mb-2">
                    <div class="col">
                        <span class="fw-bold">@Html.DisplayNameFor(model => Model.Inmueble.Duenio).ToUpper():</span>
                        &nbsp;
                        <span>@(Model.Inmueble.Duenio != null ? Model.Inmueble.Duenio.ToString().Split('-').ElementAt(0) : "Sin Dueño")</span>
                    </div>
                </div>
                <div class="row mb-2">
                    <div class="col">
                        <span class="fw-bold">@Html.DisplayNameFor(model => Model.Inmueble.Precio).ToUpper():</span>
                        &nbsp;
                        <span>$ @Model.Inmueble.Precio</span>
                    </div>
                </div>
                <div class="row mb-2">
                    <div class="col">
                        <span class="fw-bold">@Html.DisplayNameFor(model => Model.Inmueble.Senia).ToUpper():</span>
                        &nbsp;
                        <span>@(Model.Inmueble.Senia)%</span>
                    </div>
                </div>
                <div class="row mb-2">
                    <div class="col">
                        <span class="fw-bold">@Html.DisplayNameFor(model => Model.Inmueble.Disponible).ToUpper():</span>
                        &nbsp;
                        <span>@(Model.Inmueble.Disponible ? "✔" : "❌")</span>
                    </div>
                </div>
                <div class="row mb-2">
                    <div class="col">
                        <span class="fw-bold">@Html.DisplayNameFor(model => Model.Inmueble.Latitud).ToUpper():</span>
                        &nbsp;
                        <span>@Model.Inmueble.Latitud</span>
                    </div>
                </div>
                <div class="row">
                    <div class="col">
                        <span class="fw-bold">@Html.DisplayNameFor(model => Model.Inmueble.Longitud).ToUpper():</span>
                        &nbsp;
                        <span>@Model.Inmueble.Longitud</span>
                    </div>
                </div>
            </div>
        </div>
        <div class="row mt-4">
            <div class="col-8 offset-2">
                <div id="carouselExample" class="carousel slide">
                    <div class="carousel-indicators">
                        @for(int i = 0; i < Model.Fotos.Count; i++){
                            <button 
                                type="button" 
                                data-bs-target="#carouselExampleIndicators" 
                                data-bs-slide-to="@i" 
                                aria-label="Slide @i+1"
                                class="@(i==0?"active":"")"
                                aria-current="@(i==0?"true":"false")"
                            >
                            </button>
                        }
                    </div>
                    <div class="carousel-inner">
                        @if(Model.Fotos.Count != 0){
                            @for(int i = 0; i < Model.Fotos.Count; i++){
                                <div class="carousel-item @(i==0?"active":"")">
                                    <img src="@Model.Fotos[i]" class="d-block w-100" alt="foto">
                                </div>
                            }
                        }else{
                            <div class="carousel-item active">
                                <img src="/Uploads\\foto.jpg" class="d-block w-100" alt="No hay fotos">
                            </div>
                        }
                    </div>
                    <button class="carousel-control-prev" type="button" data-bs-target="#carouselExample" data-bs-slide="prev">
                        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                        <span class="visually-hidden">Previous</span>
                    </button>
                    <button class="carousel-control-next" type="button" data-bs-target="#carouselExample" data-bs-slide="next">
                        <span class="carousel-control-next-icon" aria-hidden="true"></span>
                        <span class="visually-hidden">Next</span>
                    </button>
                </div>
            </div>
        </div>
    } else {
        <p class="display-5">No hay datos</p>
    }
</div>