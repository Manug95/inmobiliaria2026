@using inmobiliaria2026.Models.ViewModels
@model ReservasPorVencerViewModel
@{
    ViewData["Title"] = "Reservas por Vencer";
}

<div class="container-fluid shadow border rounded-4 bg-light-subtle position-relative">
    <h1 class="text-center display-4">Reservas Por Vencer</h1>
    <p class="text-center fs-5">
        <span class="text-danger fw-bold">***</span>
        Listar todos las reservas que terminen en X días (permitir elegir o especificar plazo)
        <span class="text-danger fw-bold">***</span>
    </p>

    <div class="row my-1 ms-2">
        <div class="col-12">
            <form asp-action="PorVencer" method="GET">
                <input type="hidden" name="B" value="true">
                <div class="row mb-md-4">
                    <div class="col-3 mt-5 mt-md-3 mb-md-0">
                        <label asp-for="Dias" class="form-label fw-bold">Dias</label>
                        <input type="number" asp-for="Dias" class="form-control" id="dias">
                        <span asp-validation-for="Dias" class="text-danger small ms-1"></span>
                    </div>
                    <div class="col-1 d-flex justify-content-center align-items-end">
                        <div class="fs-3 mb-4">
                            <span>- o -</span>
                        </div>
                    </div>
                    <div class="col-3 mt-5 mt-md-3 mb-md-0">
                        <label asp-for="Desde" class="form-label fw-bold">Desde</label>
                        <input type="date" asp-for="Desde" class="form-control" id="desde">
                        <span asp-validation-for="Desde" class="text-danger small ms-1"></span>
                    </div>
                    <div class="col-3 mt-5 mt-md-3 mb-md-0">
                        <label asp-for="Hasta" class="form-label fw-bold">Hasta</label>
                        <input type="date" asp-for="Hasta" class="form-control" id="hasta">
                        <span asp-validation-for="Hasta" class="text-danger small ms-1"></span>
                    </div>
                    <div class="col-2 d-flex justify-content-center align-items-end">
                        <div class="mb-4">
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-search"></i>
                                Buscar
                            </button>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>

    @if(Model.Reservas.Count() > 0) {
        <div class="table-responsive my-4 rounded-3 fixed-height-table-container-informes">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width: 100px;">
                            @Html.DisplayNameFor(model => model.Reservas[0].Id)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.Reservas[0].FechaInicio).ToUpper()
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.Reservas[0].FechaFin).ToUpper()
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.Reservas[0].Monto).ToUpper()
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.Reservas[0].FechaTerminado).ToUpper()
                        </th>
                        <th></th>
                    </tr>
                </thead>
                <tbody id="cuerpo">
                    @foreach (var item in Model.Reservas)
                    {
                        <tr id="@item.Id">
                            <td class="align-middle py-0 ps-2" style="width: 100px;">
                                @Html.DisplayFor(modelItem => item.Id)
                            </td>
                            <td class="align-middle py-0 ps-2">
                                @Html.DisplayFor(modelItem => item.FechaInicio)
                            </td>
                            <td class="align-middle py-0 ps-2">
                                @Html.DisplayFor(modelItem => item.FechaFin)
                            </td>
                            <td class="align-middle py-0 ps-2">
                                @Html.DisplayFor(modelItem => item.Monto)
                            </td>
                            <td class="align-middle py-0 ps-2">
                                @Html.DisplayFor(modelItem => item.FechaTerminado)
                            </td>
                            <td>
                                <div class="d-flex justify-content-evenly align-items-center">
                                    <i id="det-@item.Id" class="bi bi-file-earmark-text fs-3 text-info icon-hover" data-bs-toggle="tooltip" data-bs-title="Ver Detalle"></i>
                                    <a class="icon-enlace" asp-action="Index" asp-controller="Pago" asp-route-reservaId="@item.Id" data-bs-toggle="tooltip" data-bs-title="Ver Pagos">
                                        <i class="bi bi-wallet2 fs-3 text-warning"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <nav>
            <ul id="paginador" class="pagination justify-content-center">
                <li id="flecha-pag-izq" class="page-item @(ViewBag.paginaAnterior == 0 ? "disabled" : "")">
                    <a 
                        asp-action="PorVencer" 
                        asp-route-dias="@Model.Dias" 
                        asp-route-desde="@Model.Desde" 
                        asp-route-hasta="@Model.Hasta" 
                        asp-route-cantidadPaginado="@ViewBag.cantidadPaginado" 
                        asp-route-pagina="@ViewBag.paginaAnterior" 
                        class="page-link"
                    >
                        <span>&laquo;</span>
                    </a>
                </li>
                @for (int i = 1; i <= ViewBag.cantPag; i++) {
                    <li class="page-item">
                        <a 
                            asp-action="PorVencer" 
                            asp-route-dias="@Model.Dias" 
                            asp-route-desde="@Model.Desde" 
                            asp-route-hasta="@Model.Hasta" 
                            asp-route-cantidadPaginado="@ViewBag.cantidadPaginado" 
                            asp-route-pagina="@i" 
                            class="page-link @(i > ViewBag.paginaAnterior && i < ViewBag.paginaSiguiente ? "active" : "")"
                        >
                            @i
                        </a>
                    </li>
                }
                <li id="flecha-pag-der" class="page-item @(ViewBag.paginaSiguiente > ViewBag.cantPag ? "disabled" : "")">
                    <a 
                        asp-action="PorVencer" 
                        asp-route-dias="@Model.Dias" 
                        asp-route-desde="@Model.Desde" 
                        asp-route-hasta="@Model.Hasta" 
                        asp-route-cantidadPaginado="@ViewBag.cantidadPaginado" 
                        asp-route-pagina="@ViewBag.paginaSiguiente" 
                        class="page-link"
                    >
                        <span>&raquo;</span>
                    </a>
                </li>
            </ul>
        </nav>

        <partial name="_DetalleReservaModal"/>
    }
</div>

@if(!string.IsNullOrEmpty(ViewBag.MensajeError)) {
    <partial name="_MensajeError" model="ViewBag.MensajeError"/>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script type="module" src="~/js/reservas.js"></script>

    <script>
        const inputDias = document.getElementById("dias");
        const inputDesde = document.getElementById("desde");
        const inputHasta = document.getElementById("hasta");

        inputDias.addEventListener("input", _ => {
            inputDesde.value = null;
            inputHasta.value = null;
        });
        inputDesde.addEventListener("change", _ => {
            inputDias.value = null;
        });
        inputHasta.addEventListener("change", _ => {
            inputDias.value = null;
        });
    </script>
}