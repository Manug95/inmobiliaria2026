@model IEnumerable<Inquilino>
@{
    ViewData["Title"] = "Inquilinos";
}

<div class="container-fluid shadow border rounded-4 mt-1 bg-light-subtle position-relative">
    <h1 class="text-center display-4">Inquilinos</h1>

    <div class="row my-1">
       <div class="col-6">
            <form id="buscador" asp-action="Index" method="get" class="position-relative needs-validation">
                <label for="nomApe" class="form-label fw-bold">Buscar Inquilino</label>
                <div class="input-group has-validation mb-3">
                    <input type="text" id="nomApe" name="nomApe" class="form-control" placeholder="nombre o apellido del inquilino" value="@ViewBag.busqueda">
                    <span class="input-group-text" id="limpiar" style="cursor: pointer;">
                        <i class="bi bi-x-lg" data-bs-toggle="tooltip" data-bs-title="Limpiar"></i>
                    </span>
                    <div id="tpe_buscador" class="invalid-tooltip"></div>
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-search"></i>
                        Buscar
                    </button>
                </div>
                <input type="hidden" name="cantidadPaginado" value="@ViewBag.cantidadPaginado">
            </form>
        </div>
        <div class="col d-flex justify-content-end align-items-center mt-3 me-5">
            <a class="btn btn-outline-dark" asp-action="Index" asp-route-cantidadPaginado="@ViewBag.cantidadPaginado" asp-route-pagina="1">
                <i class="bi bi-arrow-clockwise"></i>
                Recargar Todos
            </a>
        </div>
    </div>
    <div class="table-responsive my-2 rounded-3 fixed-height-table-container">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>
                        @Html.DisplayNameFor(model => model.Apellido).ToUpper()
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Nombre).ToUpper()
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Dni).ToUpper()
                    </th>
                    <th>
                        @Html.DisplayNameFor(model => model.Telefono).ToUpper()
                    </th>
                    <th colspan="2">
                        @Html.DisplayNameFor(model => model.Email).ToUpper()
                    </th>
                    <th></th>
                </tr>
            </thead>
            <tbody id="cuerpo">
                @foreach (var item in Model)
                {
                    <tr id="@item.Id">
                        <td class="align-middle py-0 ps-2">
                            @Html.DisplayFor(modelItem => item.Apellido)
                        </td>
                        <td class="align-middle py-0 ps-2">
                            @Html.DisplayFor(modelItem => item.Nombre)
                        </td>
                        <td class="align-middle py-0 ps-2">
                            @Html.DisplayFor(modelItem => item.Dni)
                        </td>
                        <td class="align-middle py-0 ps-2">
                            @Html.DisplayFor(modelItem => item.Telefono)
                        </td>
                        <td class="align-middle py-0 ps-2" colspan="2">
                            @Html.DisplayFor(modelItem => item.Email)
                        </td>
                        <td>
                            <div class="d-flex justify-content-evenly align-items-center">
                                <i id="edit-@item.Id" class="bi bi-pencil-square fs-3 text-primary icon-hover" style="cursor: pointer;" data-bs-toggle="tooltip" data-bs-title="Editar"></i>
                                @if (User.IsInRole(Rol.ADMIN.ToString())){
                                    <i id="del-@item.Id" class="bi bi-trash fs-3 text-danger icon-hover" style="cursor: pointer;" data-bs-toggle="tooltip" data-bs-title="Eliminar"></i>
                                }
                                <a class="icon-enlace" asp-controller="Inmueble" asp-action="Reservar" asp-route-idInquilino="@item.Id" data-bs-toggle="tooltip" data-bs-title="Reservar Inmueble">
                                    <i class="bi bi-house-door fs-3 text-success icon-hover"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <nav>
        <ul id="paginador" class="pagination justify-content-center">
            <li id="flecha-pag-izq" class="page-item @(ViewBag.paginaAnterior == 0 ? "disabled" : "")" data-bs-toggle="tooltip" data-bs-title="Anterior">
                <a asp-action="Index" asp-route-nomApe="@ViewBag.busqueda" asp-route-cantidadPaginado="@ViewBag.cantidadPaginado" asp-route-pagina="@ViewBag.paginaAnterior" class="page-link"><span>&laquo;</span></a>
            </li>
            @for (int i = 1; i <= ViewBag.cantPag; i++) {
                <li class="page-item">
                    <a asp-action="Index" asp-route-nomApe="@ViewBag.busqueda" asp-route-cantidadPaginado="@ViewBag.cantidadPaginado" asp-route-pagina="@i" class="page-link @(i > ViewBag.paginaAnterior && i < ViewBag.paginaSiguiente ? "active" : "")">@i</a>
                </li>
            }
            <li id="flecha-pag-der" class="page-item @(ViewBag.paginaSiguiente > ViewBag.cantPag ? "disabled" : "")" data-bs-toggle="tooltip" data-bs-title="Siguiente">
                <a asp-action="Index" asp-route-nomApe="@ViewBag.busqueda" asp-route-cantidadPaginado="@ViewBag.cantidadPaginado" asp-route-pagina="@ViewBag.paginaSiguiente" class="page-link"><span>&raquo;</span></a>
            </li>
        </ul>
    </nav>
    <div id="btn_add" class="position-absolute bottom-0 end-0 me-4 mb-2" style="cursor: pointer;">
        <i class="bi bi-plus-square fs-1 text-primary icon-hover d-inline-block" data-bs-toggle="tooltip" data-bs-title="Registrar Nuevo"></i>
    </div>
</div>

<partial name="_InquilinoFormModal" model="@new Inquilino()"/>
@if (User.IsInRole(Rol.ADMIN.ToString())) {
    <partial name="_ModalEliminar"/>
}
@if(!string.IsNullOrEmpty(ViewBag.MensajeError)) {
    <partial name="_MensajeError" model="ViewBag.MensajeError"/>
}

<script type="module" src="~/js/inquilinos.js"></script>