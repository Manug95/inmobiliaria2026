@using inmobiliaria2026.Models.ViewModels
@model InquilinoViewModel
@{
    ViewData["Title"] = "Inquilinos";
}

<link rel="stylesheet" href="~/css/tablas.css">
<link rel="stylesheet" href="~/css/styles.css">

<h1 id="titulo" data-modelo="@nameof(Inquilino)" class="text-center mt-2">Inquilinos</h1>

@*aca va la tabla*@
<partial name="_InquilinoTabla" model="Model.Inquilinos"/>
<partial name="_InquilinoFormModal" model="Model.Inquilino"/>
<partial name="_ModalPregunta"/>
@if(!string.IsNullOrEmpty(Model.MensajeError)) {
    <partial name="_MensajeError" model="Model.MensajeError"/>
}



<script type="module" src="~/js/inquilinos.js"></script>